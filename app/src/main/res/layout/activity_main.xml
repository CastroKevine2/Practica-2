<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <!-- ====== RAIZ: todo encadenado en cascada ====== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp">

        <!--  AVATAR (cabeza de la cadena)  -->
        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:contentDescription="@string/avatar_desc"
            android:src="@drawable/persona"
            app:layout_constraintBottom_toBottomOf="@id/tvTitulo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <!--  TITULO  -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/titulo_registro"
            android:textColor="@color/azul_titulo"
            android:textSize="27sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tilNombres"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgAvatar" />

        <!--  NOMBRES  -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombres"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/nombres"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeWidth="1.5dp"
            app:boxStrokeWidthFocused="2dp"
            app:startIconDrawable="@drawable/persona"
            app:startIconTint="#1122EE"
            app:layout_constraintBottom_toTopOf="@id/tilApellidos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textColor="@color/texto_campo"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--  APELLIDOS  -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApellidos"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/apellidos"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeWidth="1.5dp"
            app:boxStrokeWidthFocused="2dp"
            app:startIconDrawable="@drawable/persona"
            app:startIconTint="#1122EE"
            app:layout_constraintBottom_toTopOf="@id/tilTipoDoc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilNombres">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApellidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textColor="@color/texto_campo"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--  TIPO DE DOCUMENTO  -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTipoDoc"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/tipo_documento"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeWidth="1.5dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconDrawable="@drawable/ic_flecha_abajo"
            app:endIconMode="custom"
            app:endIconTint="#3C3C3C"
            app:startIconDrawable="@drawable/idcard"
            app:startIconTint="#1122EE"
            app:layout_constraintBottom_toTopOf="@id/tilNumeroId"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilApellidos">

            <AutoCompleteTextView
                android:id="@+id/actvTipoDoc"
                style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/texto_campo"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--  NUMERO DE IDENTIDAD  -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNumeroId"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/numero_identidad"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeWidth="1.5dp"
            app:boxStrokeWidthFocused="2dp"
            app:startIconDrawable="@drawable/idcard"
            app:startIconTint="#1122EE"
            app:layout_constraintBottom_toTopOf="@id/tvGenero"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilTipoDoc">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNumeroId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@color/texto_campo"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--  GENERO: titulo  -->
        <LinearLayout
            android:id="@+id/tvGenero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/rgGenero"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilNumeroId">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/genero"
                android:src="@drawable/generos" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/genero"
                android:textColor="@color/texto_titulo_campo"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!--  GENERO: RadioGroup horizontal  -->
        <RadioGroup
            android:id="@+id/rgGenero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/filaFecha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGenero">

            <RadioButton
                android:id="@+id/rbHombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#1A1A1A"
                android:checked="true"
                android:drawableStart="@drawable/hombre"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/genero_hombre"
                android:textColor="@color/texto_campo"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/rbMujer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#1A1A1A"
                android:drawableStart="@drawable/mujer"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/genero_mujer"
                android:textColor="@color/texto_campo"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/rbOtro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#1A1A1A"
                android:gravity="center_vertical"
                android:text="@string/genero_otro"
                android:textColor="@color/texto_campo"
                android:textSize="17sp" />
        </RadioGroup>

        <!--  FECHA: DIA / MES / ANIO  -->
        <LinearLayout
            android:id="@+id/filaFecha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rgGenero">

            <!-- DIA -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDia"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/dia"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconDrawable="@drawable/ic_flecha_abajo"
                app:endIconMode="custom"
                app:endIconTint="#3C3C3C">

                <AutoCompleteTextView
                    android:id="@+id/actvDia"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/texto_campo"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- MES -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMes"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/mes"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconDrawable="@drawable/ic_flecha_abajo"
                app:endIconMode="custom"
                app:endIconTint="#3C3C3C">

                <AutoCompleteTextView
                    android:id="@+id/actvMes"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/texto_campo"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ANIO -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAnio"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/anio"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconDrawable="@drawable/ic_flecha_abajo"
                app:endIconMode="custom"
                app:endIconTint="#3C3C3C">

                <AutoCompleteTextView
                    android:id="@+id/actvAnio"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/texto_campo"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
